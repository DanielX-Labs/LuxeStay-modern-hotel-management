NODE_ENV=development
PORT=3035
API_URL=http://localhost:3035
CLIENT_URL=http://localhost:3034
ADMIN_URL=http://localhost:3033

MONGODB_URI=mongodb://127.0.0.1:27017/luxestay
MONGODB_USERNAME=
MONGODB_PASSWORD=

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_password

JWT_ACCESS_SECRET=replace_with_a_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_a_long_random_refresh_secret
JWT_ACCESS_EXPIRES=25m
JWT_REFRESH_EXPIRES=30d
COOKIE_EXPIRES_DAYS=30

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

BREVO_SENDER_EMAIL=no-reply@example.com
BREVO_SENDER_NAME=LuxeStay
SUPPORT_EMAIL=support@example.com
BREVO_EMAIL_TRANSPORT=smtp
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_LOGIN=your_smtp_login
BREVO_SMTP_KEY=your_smtp_key

LOG_LEVEL=info
